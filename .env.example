# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Secreto HMAC para verificar firmas de EventSub (10–100 caracteres)
TWITCH_EVENTSUB_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_REWARD_ID=

# YouTube / Google OAuth
YOUTUBE_PLAYLIST_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# StreamElements (chat)
SE_CHANNEL_ID=
SE_JWT=

# Autoriza la llamada de twitch-webhook a process-redemption
INTERNAL_SECRET=

# Opcional: fallback de chat con la cuenta del canal (scope user:write:chat)
TWITCH_CHAT_USER_TOKEN=

# Solo para scripts/setup-eventsub.ts: URL pública de la función
WEBHOOK_URL=
